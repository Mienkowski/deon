# ─────────────────────────────────────────────────────────────────────────────
# Name Clearance Assistant — przykładowa konfiguracja środowiska
# Skopiuj do `.env.local` (Next.js) i uzupełnij. NIE commituj `.env.local`.
# Aplikacja działa BEZ żadnego z poniższych kluczy (tryb w pełni lokalny).
# ─────────────────────────────────────────────────────────────────────────────

# Środowisko: development | production
NODE_ENV=development

# ── Opcjonalny LLM (warstwa wzbogacająca: semantyka + sugestia klas nicejskich)
# Bez klucza aplikacja korzysta wyłącznie z algorytmów lokalnych.
# LLM NIGDY nie nadpisuje danych źródłowych — dostarcza jedynie sygnał pomocniczy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Konektory realnych źródeł (domyślnie wyłączone / manualne) ──────────────
# Domeny: realny RDAP jest włączony domyślnie (publiczny standard, bez klucza).
CONNECTOR_DOMAINS_RDAP_ENABLED=true
CONNECTOR_HTTP_TIMEOUT_MS=6000

# Poniższe wymagają umów/kluczy dostawców i pozostają w trybie "manual" póki puste.
EUIPO_TMVIEW_API_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
KRS_API_ENABLED=false

# ── Limity / bezpieczeństwo ────────────────────────────────────────────────
RATE_LIMIT_SEARCH_PER_MINUTE=20
MAX_LOGO_UPLOAD_BYTES=2000000
